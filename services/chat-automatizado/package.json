{
  "name": "chat-automatizado",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "dependencies": {
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mysql2": "^3.20.0",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "migrate": "npx sequelize-cli db:migrate --config config/config.cjs",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config config/config.cjs",
    "seed": "npx sequelize-cli db:seed:all --config config/config.cjs",
    "setup": "npm run migrate && npm run seed"
  }
}
