    {
      "name": "💬 Sesión (flujo del bot)",
      "item": [
        {
          "name": "POST /session — Iniciar sesión CLIENTE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id_session) {",
                  "    pm.collectionVariables.set('session_id', json.data.id_session);",
                  "    console.log('session_id guardado:', json.data.id_session);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 1,\n  \"user_type\": \"cliente\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/session", "host": ["{{base_url}}"], "path": ["session"] }
